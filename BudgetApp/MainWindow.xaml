<Window x:Class="BudgetApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:BudgetApp.Services"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Budgeter" Height="820" Width="1320" MinWidth="1060" MinHeight="640"
        Background="#F4F5F9"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <svc:EuroConverter x:Key="Euro"/>
        <!-- Reusable "card" style: white rounded panel with a soft border, used everywhere -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="#E4E6ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#22243B"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#767A8A"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9A9DAB"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="#D8DAE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="#FAFBFD"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Primary action button (filled, accent color) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Destructive button, used for delete/remove actions -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFECEC"/>
            <Setter Property="Foreground" Value="#D64545"/>
        </Style>

        <!-- Quiet button, used for neutral actions (edit, pause, navigation) -->
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#ECEFFD"/>
            <Setter Property="Foreground" Value="#3048C4"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#767A8A"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StatSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9A9DAB"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#767A8A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,0,6,6"/>
            <Setter Property="BorderBrush" Value="#E4E6ED"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3E8FD"/>
                    <Setter Property="Foreground" Value="#22243B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Amount column: green for income, red for expenses -->
        <Style x:Key="AmountCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#D64545"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Income">
                    <Setter Property="Foreground" Value="#1F9D8F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightAligned" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="StatusCell" TargetType="TextBlock">
            <Setter Property="Text" Value="Active"/>
            <Setter Property="Foreground" Value="#1F9D8F"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Text" Value="Paused"/>
                    <Setter Property="Foreground" Value="#9A9DAB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Balance sheet cards -->
            <RowDefinition Height="*"/>      <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Budgeter" FontSize="26" FontWeight="Bold" Foreground="#22243B" VerticalAlignment="Center"/>

            <!-- Period navigator: totals, chart, history and export all follow the chosen period -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button x:Name="PrevPeriodButton" Content="◀" Style="{StaticResource QuietButton}" Width="38" Height="38"
                        ToolTip="Previous month" Click="PrevPeriodButton_Click"/>
                <TextBlock x:Name="PeriodLabel" Text="" FontSize="16" FontWeight="SemiBold" Foreground="#22243B"
                           Width="170" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="NextPeriodButton" Content="▶" Style="{StaticResource QuietButton}" Width="38" Height="38"
                        ToolTip="Next month" Click="NextPeriodButton_Click"/>
                <Button x:Name="ThisMonthButton" Content="This month" Style="{StaticResource QuietButton}" Height="38"
                        Margin="10,0,0,0" Click="ThisMonthButton_Click"/>
                <Button x:Name="AllTimeButton" Content="All time" Style="{StaticResource QuietButton}" Height="38"
                        Margin="6,0,0,0" Click="AllTimeButton_Click"/>
            </StackPanel>

            <Button Grid.Column="2" x:Name="ExportCsvButton" Content="Export to CSV"
                    Style="{StaticResource PrimaryButton}" Click="ExportCsvButton_Click" Height="38"/>
        </Grid>

        <!-- ===================== BALANCE SHEET ===================== -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                <StackPanel>
                    <TextBlock Text="INCOME" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TotalIncomeText" Text="€ 0,00" Style="{StaticResource StatValue}" Foreground="#1F9D8F"/>
                    <TextBlock x:Name="IncomeSubText" Text=" " Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,8,16">
                <StackPanel>
                    <TextBlock Text="EXPENSES" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TotalExpensesText" Text="€ 0,00" Style="{StaticResource StatValue}" Foreground="#FF6B6B"/>
                    <TextBlock x:Name="ExpensesSubText" Text=" " Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                <StackPanel>
                    <TextBlock Text="NET BALANCE" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="NetBalanceText" Text="€ 0,00" Style="{StaticResource StatValue}" Foreground="#4361EE"/>
                    <TextBlock x:Name="NetSubText" Text=" " Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== MAIN CONTENT ===================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== LEFT COLUMN: input forms ========== -->
            <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Add / edit transaction (income / expense). Enter submits. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="TransactionForm" KeyDown="TransactionForm_KeyDown">
                            <TextBlock x:Name="TransactionFormHeader" Text="Add Income / Expense" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="Type" Style="{StaticResource InputLabel}"/>
                            <ComboBox x:Name="TypeComboBox" SelectedIndex="1">
                                <ComboBoxItem Content="Income"/>
                                <ComboBoxItem Content="Expense"/>
                            </ComboBox>

                            <TextBlock Text="Category" Style="{StaticResource InputLabel}"/>
                            <ComboBox x:Name="CategoryComboBox" IsEditable="True"/>

                            <TextBlock Text="Amount (€)" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="AmountTextBox" ToolTip="12,50 and 12.50 both work"/>

                            <TextBlock Text="Date" Style="{StaticResource InputLabel}"/>
                            <DatePicker x:Name="TransactionDatePicker"/>

                            <TextBlock Text="Description" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="DescriptionTextBox"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SaveTransactionButton" Content="Add Entry" Style="{StaticResource PrimaryButton}"
                                        Click="SaveTransactionButton_Click" Height="38"/>
                                <Button x:Name="CancelEditButton" Grid.Column="1" Content="Cancel" Style="{StaticResource QuietButton}"
                                        Click="CancelEditButton_Click" Height="38" Width="90" Margin="8,0,0,0"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Add recurring / programmed expense. Enter submits. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel KeyDown="RecurringForm_KeyDown">
                            <TextBlock Text="Add Programmed Expense" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Subscriptions, rent, insurance… entered once and counted every month from the start date."
                                       Style="{StaticResource HintText}" Margin="0,-6,0,12"/>

                            <TextBlock Text="Name" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="RecurringNameTextBox"/>

                            <TextBlock Text="Category" Style="{StaticResource InputLabel}"/>
                            <ComboBox x:Name="RecurringCategoryComboBox" IsEditable="True"/>

                            <TextBlock Text="Amount (€)" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="RecurringAmountTextBox" ToolTip="The amount per week, month or year, as chosen below"/>

                            <TextBlock Text="Frequency" Style="{StaticResource InputLabel}"/>
                            <ComboBox x:Name="FrequencyComboBox" SelectedIndex="1">
                                <ComboBoxItem Content="Weekly"/>
                                <ComboBoxItem Content="Monthly"/>
                                <ComboBoxItem Content="Yearly"/>
                            </ComboBox>

                            <TextBlock Text="Starts" Style="{StaticResource InputLabel}"/>
                            <DatePicker x:Name="RecurringStartDatePicker"/>

                            <Button Content="Add Recurring Expense" Style="{StaticResource PrimaryButton}"
                                    Click="AddRecurringButton_Click" Height="38" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ========== RIGHT COLUMN: chart + lists ========== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="330"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pie chart: where the income went (or, when overspending, how spending splits) -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" x:Name="ChartHeader" Text="Where the income goes" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                            <TextBlock DockPanel.Dock="Top" x:Name="ChartSubHeader" Text=" " Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                            <Grid>
                                <lvc:PieChart x:Name="ExpensePieChart" LegendPosition="Right"/>
                                <TextBlock x:Name="ChartEmptyText" Text="Add income and expenses for this period to see the breakdown."
                                           Style="{StaticResource HintText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" MaxWidth="240" Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Programmed expenses list -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Programmed Expenses" Style="{StaticResource SectionHeader}"/>
                            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RecurringTotalText" Text=" " Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="ToggleRecurringButton" Content="Pause" Style="{StaticResource QuietButton}"
                                        Height="32" Width="90" Click="ToggleRecurringButton_Click"/>
                                <Button Grid.Column="2" Content="Remove" Style="{StaticResource DangerButton}"
                                        Height="32" Width="90" Margin="8,0,0,0" Click="DeleteRecurringButton_Click"/>
                            </Grid>
                            <DataGrid x:Name="RecurringGrid" SelectionChanged="RecurringGrid_SelectionChanged"
                                      KeyDown="RecurringGrid_KeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                    <DataGridTextColumn Header="Per month" Binding="{Binding MonthlyAmount, Converter={StaticResource Euro}}" Width="Auto"
                                                        ElementStyle="{StaticResource RightAligned}"/>
                                    <DataGridTextColumn Header="Status" Width="Auto" ElementStyle="{StaticResource StatusCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Transaction log -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Text="Transaction History" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="HistoryCountText" Text=" " Style="{StaticResource HintText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        </Grid>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Edit Selected" Style="{StaticResource QuietButton}" Height="32" Width="130"
                                    Click="EditTransactionButton_Click"/>
                            <Button Content="Delete Selected" Style="{StaticResource DangerButton}" Height="32" Width="130"
                                    Margin="8,0,0,0" Click="DeleteTransactionButton_Click"/>
                            <TextBlock Text="Tip: double-click a row to edit it, Delete key removes it." Style="{StaticResource HintText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <DataGrid x:Name="TransactionsGrid"
                                      MouseDoubleClick="TransactionsGrid_MouseDoubleClick" KeyDown="TransactionsGrid_KeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource Euro}}" Width="120"
                                                        ElementStyle="{StaticResource AmountCell}"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="HistoryEmptyText" Text="No entries in this period yet."
                                       Style="{StaticResource HintText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
