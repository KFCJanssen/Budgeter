<Window x:Class="BudgetApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Budgeter" Height="860" Width="1400" MinWidth="1100" MinHeight="660"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI"
        Icon="Assets/budgeter.ico"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <Image Source="Assets/budgeter.ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Budgeter" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Bottom area: warnings, updates, version -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border x:Name="DevBuildBanner" Background="{StaticResource WarnSoftBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Old copy of Budgeter" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                            <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource TextBrush}" Margin="0,2,0,6"
                                       Text="You started a build from a Visual Studio folder. It won't update itself."/>
                            <Button Content="How to fix your shortcut" Style="{StaticResource LinkButton}" Click="DevBuildHelp_Click"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="UpdateBanner" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="UpdateText" Text="Update available" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}"/>
                            <Button x:Name="UpdateButton" Content="Install update" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                    Click="UpdateButton_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" Text="Version" Style="{StaticResource HintText}" Margin="10,4,0,0"/>
                </StackPanel>

                <StackPanel x:Name="NavPanel">
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Dashboard" x:Name="NavDashboard" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="Transactions" x:Name="NavTransactions" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8EE;" Content="Programmed" x:Name="NavProgrammed" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xEB05;" Content="Budgets &amp; goals" x:Name="NavBudgets" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D2;" Content="Trends" x:Name="NavTrends" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE896;" Content="Import from bank" x:Name="NavImport" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8EF;" Content="Calculators" x:Name="NavTools" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE77B;" Content="Profile &amp; report" x:Name="NavProfile" Checked="Nav_Checked"/>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,12"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE897;" Content="Help &amp; guides" x:Name="NavHelp" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" x:Name="NavSettings" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== PAGE ===================== -->
        <ContentControl Grid.Column="1" x:Name="PageHost" Margin="28,24,28,20" Focusable="False"/>

        <!-- ===================== TOAST ===================== -->
        <Border Grid.Column="1" x:Name="ToastBorder" Background="#22243B" CornerRadius="10" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" Foreground="White" VerticalAlignment="Center" MaxWidth="560" TextWrapping="Wrap"/>
                <Button x:Name="ToastAction" Style="{StaticResource LinkButton}" Foreground="#9DB0FF" Margin="16,0,0,0"
                        VerticalAlignment="Center" Click="ToastAction_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
