<UserControl x:Class="BudgetApp.Controls.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shows one guide: numbered steps, then tips. -->
    <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,0,4"/>
        <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" Margin="0,0,0,16"/>
        <ItemsControl x:Name="StepList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource BodyText}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl x:Name="TipList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82F;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarnBrush}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" MaxWidth="640"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
