<Window x:Class="BudgetApp.Controls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Budgeter" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource CardBrush}" FontFamily="Segoe UI">
    <!-- Small "type a value" dialog, e.g. for adding money to a goal. -->
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Style="{StaticResource BodyText}" Margin="0,0,0,10"/>
        <TextBox x:Name="ValueBox" KeyDown="ValueBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Cancel" Style="{StaticResource QuietButton}" Width="90" IsCancel="True"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Width="90" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
