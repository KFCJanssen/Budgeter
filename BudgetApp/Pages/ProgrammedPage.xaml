<UserControl x:Class="BudgetApp.Pages.ProgrammedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Programmed income &amp; costs" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Things that come back every week, month or year - salary, rent, subscriptions, insurance. Enter them once; they count in every month from their start date."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                <StackPanel>
                    <TextBlock Text="PROGRAMMED INCOME / MONTH" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="IncomeText" Style="{StaticResource StatValue}" Foreground="{StaticResource GoodBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,8,16">
                <StackPanel>
                    <TextBlock Text="FIXED COSTS / MONTH" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="CostsText" Style="{StaticResource StatValue}" Foreground="#FF6B6B"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                <StackPanel>
                    <TextBlock Text="LEFT AFTER FIXED COSTS" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="LeftText" Style="{StaticResource StatValue}"/>
                    <TextBlock x:Name="LeftSub" Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Edit" Style="{StaticResource QuietButton}" Width="70" Click="Edit_Click"/>
                        <Button x:Name="ToggleButton" Content="Pause" Style="{StaticResource QuietButton}" Width="90" Margin="8,0,0,0" Click="Toggle_Click"/>
                        <Button Content="Remove" Style="{StaticResource DangerButton}" Width="90" Margin="8,0,0,0" Click="Remove_Click"/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="420"
                                   Text="Pause something you cancelled: it stops counting from now on but stays in past months."/>
                    </StackPanel>
                    <Grid>
                        <DataGrid x:Name="ItemsGrid" SelectionChanged="ItemsGrid_SelectionChanged" MouseDoubleClick="ItemsGrid_MouseDoubleClick"
                                  KeyDown="ItemsGrid_KeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Ellipsis}"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="70"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" ElementStyle="{StaticResource Ellipsis}"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="130" ElementStyle="{StaticResource RightAligned}"/>
                                <DataGridTextColumn Header="Per month" Binding="{Binding MonthlyText}" Width="100" ElementStyle="{StaticResource RightAligned}"/>
                                <DataGridTextColumn Header="Since" Binding="{Binding Since}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource HintText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="360"
                                   Text="Nothing programmed yet. Start with your income (salary, allowance, student finance) and your rent."/>
                    </Grid>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel KeyDown="Form_KeyDown">
                        <TextBlock x:Name="FormHeader" Text="Add programmed item" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="TypeExpense" Content="Cost" GroupName="RecType" Style="{StaticResource SegmentButton}" IsChecked="True"/>
                            <RadioButton x:Name="TypeIncome" Content="Income" GroupName="RecType" Style="{StaticResource SegmentButton}"/>
                        </StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="NameBox" ToolTip="E.g. Netflix, Rent, Salary. Use the name your bank shows, so bank imports can match it."/>
                        <TextBlock Text="Category" Style="{StaticResource InputLabel}"/>
                        <ComboBox x:Name="CategoryBox" IsEditable="True"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Amount (€)" Style="{StaticResource InputLabel}"/>
                                <TextBox x:Name="AmountBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Every" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="FrequencyBox" SelectedIndex="1">
                                    <ComboBoxItem Content="Week"/>
                                    <ComboBoxItem Content="Month"/>
                                    <ComboBoxItem Content="Year"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Starts" Style="{StaticResource InputLabel}"/>
                        <DatePicker x:Name="StartBox"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SaveButton" Content="Add" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Style="{StaticResource QuietButton}" Width="86" Margin="8,0,0,0"
                                    Click="Cancel_Click" Visibility="Collapsed"/>
                        </Grid>
                        <Border Style="{StaticResource SoftPanel}" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource MutedBrush}"
                                       Text="Tip: when you import your bank file, payments with a matching name and amount are linked to these items automatically, so they are not counted twice."/>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
