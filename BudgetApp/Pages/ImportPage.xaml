<UserControl x:Class="BudgetApp.Pages.ImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BudgetApp.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="StepChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SummaryChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Import from bank" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Download a file from your bank's website and bring all transactions in at once. Nothing is saved until you click Import." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Full guide" Style="{StaticResource QuietButton}" VerticalAlignment="Center" Click="FullGuide_Click"/>
        </Grid>

        <!-- Step indicator -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Border x:Name="Chip1" Style="{StaticResource StepChip}"><TextBlock x:Name="Chip1Text" Text="1  Choose file"/></Border>
            <Border x:Name="Chip2" Style="{StaticResource StepChip}"><TextBlock x:Name="Chip2Text" Text="2  Check columns"/></Border>
            <Border x:Name="Chip3" Style="{StaticResource StepChip}"><TextBlock x:Name="Chip3Text" Text="3  Review"/></Border>
            <Border x:Name="Chip4" Style="{StaticResource StepChip}"><TextBlock x:Name="Chip4Text" Text="4  Done"/></Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- ======================= STEP 1: choose file ======================= -->
            <Grid x:Name="Step1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Which bank is the file from?" Style="{StaticResource SectionHeader}"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="BankIng" Content="ING" GroupName="Bank" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="Bank_Checked"/>
                            <RadioButton x:Name="BankRabo" Content="Rabobank" GroupName="Bank" Style="{StaticResource SegmentButton}" Checked="Bank_Checked"/>
                            <RadioButton x:Name="BankAbn" Content="ABN AMRO" GroupName="Bank" Style="{StaticResource SegmentButton}" Checked="Bank_Checked"/>
                            <RadioButton x:Name="BankOther" Content="Other bank" GroupName="Bank" Style="{StaticResource SegmentButton}" Checked="Bank_Checked"/>
                        </StackPanel>

                        <!-- Drop zone -->
                        <Border DockPanel.Dock="Bottom" x:Name="DropZone" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                                DragLeave="DropZone_DragLeave" Background="{StaticResource PageBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="2" Padding="20" Margin="0,12,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Drop the downloaded file here" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" Margin="0,6,0,8"/>
                                <Button Content="Choose file…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Width="160"
                                        Click="ChooseFile_Click"/>
                                <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                           Text=".csv, .txt or .tab - nothing is saved until you click Import"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <c:GuideView x:Name="BankGuide"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MaxHeight="260"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Previous imports" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="HistoryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Undo" Style="{StaticResource DangerButton}" MinHeight="28" Padding="10,3"
                                                            VerticalAlignment="Center" Tag="{Binding Batch}" Click="UndoHistory_Click"
                                                            ToolTip="Remove all transactions of this import"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="NoHistory" Text="No imports yet." Style="{StaticResource HintText}"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Your rules" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,10"
                                       Text="Rows whose payee or description contains the text get the category. Made automatically when you change a category while reviewing."/>
                            <Border DockPanel.Dock="Bottom" Style="{StaticResource SoftPanel}" Margin="0,10,0,0">
                                <StackPanel KeyDown="RuleForm_KeyDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="If it contains" Style="{StaticResource InputLabel}"/>
                                            <TextBox x:Name="RulePattern" Margin="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Category" Style="{StaticResource InputLabel}"/>
                                            <ComboBox x:Name="RuleCategory" IsEditable="True" Margin="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <CheckBox x:Name="RuleTransfer" Content="It's a transfer to my own account" VerticalAlignment="Center"/>
                                        <Button Content="Add rule" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Click="AddRule_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="RuleList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip="{Binding Text}"/>
                                                    <Button Grid.Column="1" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" Style="{StaticResource DangerButton}"
                                                            Width="28" Height="28" MinHeight="28" Padding="0" Tag="{Binding Rule}" Click="DeleteRule_Click" ToolTip="Remove rule"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="NoRules" Style="{StaticResource HintText}" Text="No rules yet."/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================= STEP 2: columns ======================= -->
            <Grid x:Name="Step2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Back" Style="{StaticResource QuietButton}" Width="80" Click="Back1_Click"/>
                            <Button Content="Next: review" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="ToReview_Click"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Which column is which?" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="MappingIntro" Style="{StaticResource HintText}" Margin="0,0,0,14"/>
                                <CheckBox x:Name="HasHeaderBox" Content="The first line has column names" Margin="0,0,0,12" Checked="Mapping_Changed" Unchecked="Mapping_Changed"/>
                                <TextBlock Text="Date *" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="MapDate" DisplayMemberPath="Label" SelectionChanged="Mapping_Changed"/>
                                <TextBlock Text="Date format" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="MapDateFormat" SelectionChanged="Mapping_Changed"/>
                                <TextBlock Text="Amount *" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="MapAmount" DisplayMemberPath="Label" SelectionChanged="Mapping_Changed"/>
                                <TextBlock Text="In/out column (only if amounts have no minus sign)" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="MapDebitCredit" DisplayMemberPath="Label" SelectionChanged="Mapping_Changed"/>
                                <TextBlock Text="Payee (shop, person)" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="MapPayee" DisplayMemberPath="Label" SelectionChanged="Mapping_Changed"/>
                                <TextBlock Text="Description" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="MapDescription" DisplayMemberPath="Label" SelectionChanged="Mapping_Changed"/>
                                <TextBlock Text="Description, part 2" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="MapDescription2" DisplayMemberPath="Label" SelectionChanged="Mapping_Changed"/>
                                <TextBlock Text="Counterparty account (IBAN)" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="MapCounter" DisplayMemberPath="Label" SelectionChanged="Mapping_Changed"/>
                                <TextBlock Text="Your own account (IBAN)" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="MapOwn" DisplayMemberPath="Label" SelectionChanged="Mapping_Changed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                        <TextBlock DockPanel.Dock="Top" x:Name="PreviewStatus" Style="{StaticResource HintText}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="PreviewGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Line" Binding="{Binding RowNumber}" Width="50"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="90"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{Binding Brush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Payee" Binding="{Binding Payee}" Width="*" ElementStyle="{StaticResource Ellipsis}"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.4*" ElementStyle="{StaticResource MutedCell}"/>
                                <DataGridTextColumn Header="Problem" Binding="{Binding Error}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Ellipsis}">
                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ======================= STEP 3: review ======================= -->
            <Border x:Name="Step3" Style="{StaticResource CardStyle}" Margin="0" Visibility="Collapsed">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ReviewTitle" Text="Review" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Change a category once and every row with the same payee follows - Budgeter also remembers it for next time. Untick rows you don't want."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Check columns" Style="{StaticResource QuietButton}" Click="CheckColumns_Click"/>
                            <Button Content="Help" Style="{StaticResource QuietButton}" Margin="6,0,0,0" Click="ReviewHelp_Click"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel DockPanel.Dock="Top" x:Name="SummaryChips" Margin="0,4,0,6"/>

                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Back" Style="{StaticResource QuietButton}" Width="80" Click="Back1_Click"/>
                            <CheckBox x:Name="AttentionOnly" Content="Only rows that need attention" Margin="16,0,0,0" VerticalAlignment="Center"
                                      Checked="AttentionOnly_Changed" Unchecked="AttentionOnly_Changed"/>
                            <Button Content="Tick all" Style="{StaticResource LinkButton}" Margin="16,0,0,0" VerticalAlignment="Center" Click="TickAll_Click"/>
                            <Button Content="Untick all" Style="{StaticResource LinkButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="UntickAll_Click"/>
                        </StackPanel>
                        <Button x:Name="ImportButton" Content="Import" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="200"
                                Click="Import_Click"/>
                    </Grid>

                    <DataGrid x:Name="ReviewGrid" RowHeight="36" SelectionMode="Single" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanInclude}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" Width="88"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding SignedAmount, Converter={StaticResource Euro}}" Width="100" SortMemberPath="SignedAmount">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Income">
                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Transfer">
                                                <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Payee" Binding="{Binding Payee}" Width="*" MinWidth="120" ElementStyle="{StaticResource Ellipsis}"/>
                            <DataGridTemplateColumn Header="Type" Width="92" SortMemberPath="Type">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="0" Padding="6,2" ItemsSource="{Binding TypeChoices, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Category" Width="150" SortMemberPath="Category">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="0" Padding="6,2" IsEditable="True" ItemsSource="{Binding Categories, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Programmed" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="0" Padding="6,2" ItemsSource="{Binding RecurringChoices, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding RecurringId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Why / status" Width="1.1*" MinWidth="110" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Why}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Description}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Attention}" Value="1">
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Attention}" Value="2">
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Attention}" Value="3">
                                                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ======================= STEP 4: done ======================= -->
            <Border x:Name="Step4" Style="{StaticResource CardStyle}" Margin="0" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource GoodSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{StaticResource GoodBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="DoneTitle" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,6"/>
                    <TextBlock x:Name="DoneDetails" Style="{StaticResource BodyText}" Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Content="See them" Style="{StaticResource PrimaryButton}" Width="130" Click="SeeImported_Click"/>
                        <Button Content="Import another file" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="Restart_Click"/>
                        <Button Content="Undo this import" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="UndoLast_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
