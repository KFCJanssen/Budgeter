<UserControl x:Class="BudgetApp.Pages.TransactionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BudgetApp.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Transactions" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Everything you entered or imported. Select several rows to change their category in one go." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <c:PeriodBar Grid.Column="1" x:Name="PeriodBar" Margin="0,0,12,0"/>
            <Button Grid.Column="2" Content="Export to CSV" Style="{StaticResource QuietButton}" Height="36" Click="Export_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- List -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <DockPanel>
                    <!-- Filters -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid>
                            <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Padding="30,7,8,7" Margin="0,0,0,8"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource FaintBrush}"
                                       VerticalAlignment="Top" Margin="10,10,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHint" Text="Search payee, description, category or amount" Foreground="{StaticResource FaintBrush}"
                                       VerticalAlignment="Top" Margin="31,8,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="220"/>
                                <ColumnDefinition Width="*" MaxWidth="160"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CategoryFilter" SelectionChanged="Filter_Changed" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="TypeFilter" SelectionChanged="Filter_Changed" Margin="0,0,12,0" SelectedIndex="0">
                                <ComboBoxItem Content="All types"/>
                                <ComboBoxItem Content="Income"/>
                                <ComboBoxItem Content="Expenses"/>
                                <ComboBoxItem Content="Transfers"/>
                            </ComboBox>
                            <CheckBox Grid.Column="2" x:Name="UncategorizedOnly" Content="No category only" VerticalAlignment="Top" Margin="0,8,0,0"
                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        </Grid>
                    </StackPanel>

                    <!-- Bottom bar -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock x:Name="TotalsText" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="Edit" Style="{StaticResource QuietButton}" Width="70" Margin="0,0,8,6" Click="Edit_Click"/>
                            <Button Content="Delete" Style="{StaticResource DangerButton}" Width="80" Margin="0,0,20,6" Click="Delete_Click"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Selected rows → category" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="BulkCategory" IsEditable="True" Width="150" Margin="0"/>
                                <Button Content="Apply" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="BulkApply_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <Grid>
                        <DataGrid x:Name="TxGrid" SelectionMode="Extended" MouseDoubleClick="Grid_MouseDoubleClick" KeyDown="Grid_KeyDown"
                                  SelectionChanged="Grid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" Width="84"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="0.8*" MinWidth="90" ElementStyle="{StaticResource Ellipsis}"/>
                                <DataGridTextColumn Header="Payee" Binding="{Binding Payee}" Width="*" MinWidth="100" ElementStyle="{StaticResource Ellipsis}"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.2*" MinWidth="80" ElementStyle="{StaticResource MutedCell}"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Converter={StaticResource TxNote}}" Width="78" ElementStyle="{StaticResource MutedCell}" CanUserSort="False"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Converter={StaticResource TxAmount}}" Width="100"
                                                    ElementStyle="{StaticResource AmountCell}" SortMemberPath="Amount"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource HintText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="320" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Add / edit form -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel KeyDown="Form_KeyDown">
                        <TextBlock x:Name="FormHeader" Text="Add an entry" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="TypeExpense" Content="Expense" GroupName="TxType" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="Type_Checked"/>
                            <RadioButton x:Name="TypeIncome" Content="Income" GroupName="TxType" Style="{StaticResource SegmentButton}" Checked="Type_Checked"/>
                            <RadioButton x:Name="TypeTransfer" Content="Transfer" GroupName="TxType" Style="{StaticResource SegmentButton}" Checked="Type_Checked"
                                         ToolTip="Money moved between your own accounts (e.g. to savings). Not counted as income or spending."/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Amount (€)" Style="{StaticResource InputLabel}"/>
                                <TextBox x:Name="AmountBox" ToolTip="12,50 and 12.50 both work"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date" Style="{StaticResource InputLabel}"/>
                                <DatePicker x:Name="DateBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Category" Style="{StaticResource InputLabel}"/>
                        <ComboBox x:Name="CategoryBox" IsEditable="True"/>
                        <TextBlock Text="Payee (shop, employer, person)" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="PayeeBox"/>
                        <TextBlock Text="Description" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="DescriptionBox"/>
                        <TextBlock Text="Payment of a programmed item?" Style="{StaticResource InputLabel}"/>
                        <ComboBox x:Name="RecurringBox" DisplayMemberPath="Name"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,-4,0,12"
                                   Text="Link a bank payment of rent, a subscription or your salary to its programmed item, so it isn't counted twice."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SaveButton" Content="Add entry" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Style="{StaticResource QuietButton}" Width="86" Margin="8,0,0,0"
                                    Click="Cancel_Click" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="ImportedNote" Style="{StaticResource HintText}" Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
