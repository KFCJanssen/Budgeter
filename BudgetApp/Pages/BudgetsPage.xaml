<UserControl x:Class="BudgetApp.Pages.BudgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BudgetApp.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Budgets &amp; goals" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Set a monthly limit per category, and save towards the things you want." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <c:PeriodBar Grid.Column="1" x:Name="PeriodBar"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Budgets -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock x:Name="BudgetsHeader" Text="Monthly budgets" Style="{StaticResource SectionHeader}"/>
                        <Button Content="Suggest from my spending" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="Suggest_Click" ToolTip="Fills in a budget for each category you spend on, based on the average of your last 3 months."/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" x:Name="BudgetSummary" Style="{StaticResource HintText}" Margin="0,-4,0,12"/>

                    <!-- Add / edit -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource SoftPanel}" Margin="0,12,0,0">
                        <Grid KeyDown="BudgetForm_KeyDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="BudgetFormLabel" Text="Category" Style="{StaticResource InputLabel}"/>
                                <ComboBox x:Name="BudgetCategory" IsEditable="True" Margin="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Limit per month (€)" Style="{StaticResource InputLabel}"/>
                                <TextBox x:Name="BudgetLimit" Margin="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="BudgetSave" Content="Add budget" Style="{StaticResource PrimaryButton}" Click="BudgetSave_Click"/>
                                <Button x:Name="BudgetCancel" Content="Cancel" Style="{StaticResource QuietButton}" Margin="6,0,0,0"
                                        Click="BudgetCancel_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="BudgetList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="{Binding AmountText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                                </Grid>
                                                <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding Bar, Mode=OneWay}" Foreground="{Binding Brush}" Margin="0,5,0,3"/>
                                                <TextBlock Text="{Binding RemainingText}" FontSize="11" Foreground="{Binding Brush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Content="&#xE70F;" FontFamily="{StaticResource IconFont}" Style="{StaticResource QuietButton}"
                                                        Width="32" Height="32" MinHeight="32" Padding="0" ToolTip="Change limit" Tag="{Binding}" Click="BudgetEdit_Click"/>
                                                <Button Content="&#xE74D;" FontFamily="{StaticResource IconFont}" Style="{StaticResource DangerButton}"
                                                        Width="32" Height="32" MinHeight="32" Padding="0" Margin="6,0,0,0" ToolTip="Remove budget" Tag="{Binding}" Click="BudgetDelete_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="NoBudgets" Style="{StaticResource HintText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="380"
                                   Text="No budgets yet. Add one below, or let Budgeter suggest budgets from your recent spending."/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Goals -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Savings goals" Style="{StaticResource SectionHeader}"/>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource SoftPanel}" Margin="0,12,0,0">
                        <StackPanel KeyDown="GoalForm_KeyDown">
                            <TextBlock x:Name="GoalFormHeader" Text="New goal" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="What for" Style="{StaticResource InputLabel}"/>
                                    <TextBox x:Name="GoalName"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Target (€)" Style="{StaticResource InputLabel}"/>
                                    <TextBox x:Name="GoalTarget"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Saved so far (€)" Style="{StaticResource InputLabel}"/>
                                    <TextBox x:Name="GoalSaved" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Target date (optional)" Style="{StaticResource InputLabel}"/>
                                    <DatePicker x:Name="GoalDate"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="GoalSave" Content="Add goal" Style="{StaticResource PrimaryButton}" Click="GoalSave_Click"/>
                                <Button x:Name="GoalCancel" Content="Cancel" Style="{StaticResource QuietButton}" Margin="6,0,0,0"
                                        Click="GoalCancel_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GoalList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="{Binding AmountText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                                </Grid>
                                                <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding Bar, Mode=OneWay}" Foreground="{Binding Brush}" Margin="0,6,0,6"/>
                                                <TextBlock Text="{Binding PlanText}" Style="{StaticResource HintText}" Foreground="{StaticResource MutedBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="Add money" Style="{StaticResource QuietButton}" MinHeight="28" Padding="10,4" Tag="{Binding}" Click="GoalAddMoney_Click"/>
                                                    <Button Content="Edit" Style="{StaticResource QuietButton}" MinHeight="28" Padding="10,4" Margin="6,0,0,0" Tag="{Binding}" Click="GoalEdit_Click"/>
                                                    <Button Content="Delete" Style="{StaticResource DangerButton}" MinHeight="28" Padding="10,4" Margin="6,0,0,0" Tag="{Binding}" Click="GoalDelete_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="NoGoals" Style="{StaticResource HintText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="300"
                                   Text="No goals yet. A first goal could be a buffer of one month of costs."/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
