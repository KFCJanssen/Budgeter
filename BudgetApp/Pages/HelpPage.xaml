<UserControl x:Class="BudgetApp.Pages.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BudgetApp.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Help &amp; guides" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Step-by-step guides for everything Budgeter does." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GuideList"/>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" x:Name="GoToButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Margin="40,8,0,0" Click="GoTo_Click"/>
                    <ScrollViewer x:Name="GuideScroll" VerticalScrollBarVisibility="Auto">
                        <c:GuideView x:Name="Guide" Margin="0,0,12,0" MaxWidth="760" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
