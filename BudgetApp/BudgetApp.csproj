<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BudgetApp</AssemblyName>
    <Product>Budgeter</Product>
    <ApplicationIcon>Assets\budgeter.ico</ApplicationIcon>
    <!-- The version comes from the VERSION file in the repo root, so the app knows which release it is. -->
    <BudgeterVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</BudgeterVersion>
    <Version>$(BudgeterVersion)</Version>
    <AssemblyVersion>$(BudgeterVersion)</AssemblyVersion>
    <FileVersion>$(BudgeterVersion)</FileVersion>
    <!-- Lets build servers (GitHub Actions) compile this on any OS. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BudgetApp.Core\BudgetApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite database through EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <!-- Charts -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc4.5" />
    <!-- PDF report (Community license: free for individuals) -->
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\budgeter.ico" />
  </ItemGroup>

</Project>
