<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free tests for Budgeter's logic (no NuGet packages needed).
       Run with: dotnet run, from the BudgetApp.Tests folder (exit code 0 = all passed) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BudgetApp.Core\BudgetApp.Core.csproj" />
  </ItemGroup>

</Project>
